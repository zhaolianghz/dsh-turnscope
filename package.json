{
  "name": "@zhaolianghz/dsh-turnscope",
  "version": "0.1.5",
  "private": true,
  "description": "Turn-level safety inspection, change attribution, safe rewind, and isolated retry for DeepSeek Harness coding sessions.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhaolianghz/dsh-turnscope.git"
  },
  "bugs": {
    "url": "https://github.com/zhaolianghz/dsh-turnscope/issues"
  },
  "homepage": "https://github.com/zhaolianghz/dsh-turnscope#readme",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "turnscope",
    "attribution",
    "checkpoint",
    "rewind"
  ],
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "test": "pnpm build && vitest run",
    "smoke:dsh": "pnpm build && node scripts/dsh-host-smoke.mjs",
    "smoke:browser": "pnpm build && bash docs/spikes/client-remote-smoke/run.sh",
    "check:profile": "pnpm build && node scripts/check-active-profile.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-connection": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-chat": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.1",
    "@deepseek-ai/dsh-session": "0.1.7-rc.1",
    "react": "18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh": "0.1.7-rc.1",
    "@deepseek-ai/dsh-api-gateway": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-test-runtime": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-chat": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.1",
    "@deepseek-ai/dsh-session": "0.1.7-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.7-rc.1",
    "@deepseek-ai/dsh-typert-registry": "0.1.7-rc.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.0",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "jsdom": "27.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.7.0",
  "license": "MIT"
}
